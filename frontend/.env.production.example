# ===========================================================================
# Frontend — Netlify site environment
#
# Set these in Netlify → Site configuration → Environment variables.
# NEXT_PUBLIC_* are inlined into the browser bundle at build time, so they are
# public by definition: never put a secret here.
# ===========================================================================

# --- Required ---------------------------------------------------------------

NODE_ENV=production

# The Render backend. Next rewrites /api/* to this (frontend/next.config.ts),
# which keeps every browser request same-origin — so the session cookie stays
# first-party and no cross-site cookie rules apply. No trailing slash.
API_PROXY_TARGET=https://sofaforge-api.onrender.com

# The public URL of this site. Used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Must match VITE_APP_ID on the backend — the session token carries this appId.
NEXT_PUBLIC_APP_ID=sofa-co

# Leave EMPTY. Empty means the browser calls /api/* on its own origin and the
# rewrite above forwards it. Setting it to the Render URL makes the calls
# cross-site, which then depends on third-party-cookie handling in the
# client's browser — avoid that for the review build.
NEXT_PUBLIC_API_URL=

# --- Optional ---------------------------------------------------------------

# Manus OAuth portal. Blank while admin login uses the email+password route.
NEXT_PUBLIC_OAUTH_PORTAL_URL=

# Development aid only: forces animations even when the OS asks for reduced
# motion. Leave UNSET in production so real visitors' accessibility setting is
# honoured.
NEXT_PUBLIC_FORCE_MOTION=
