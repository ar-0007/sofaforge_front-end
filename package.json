{
  "name": "sofa-co-custom",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "dev": "pnpm --parallel --filter @sofa/backend --filter @sofa/frontend dev",
    "dev:backend": "pnpm --filter @sofa/backend dev",
    "dev:frontend": "pnpm --filter @sofa/frontend dev",
    "build": "pnpm --filter @sofa/backend build && pnpm --filter @sofa/frontend build",
    "start": "pnpm --filter @sofa/backend start",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:push": "pnpm --filter @sofa/backend db:push",
    "db:seed": "pnpm --filter @sofa/backend db:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}