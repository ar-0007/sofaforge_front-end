# ---------------------------------------------------------------------------
# Local development. Copy to `.env` at the workspace root — backend and
# frontend both read this one file (backend/src/core/loadEnv.ts and
# frontend/next.config.ts).
#
# For the hosted setup do NOT use this file: see backend/.env.production.example
# (Render) and frontend/.env.production.example (Netlify).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PORT=4000

# Where the frontend dev server runs — the API allows this origin (CORS).
CORS_ORIGIN=http://localhost:3000

# The Next dev server proxies /api/* here, so the browser stays same-origin.
API_PROXY_TARGET=http://localhost:4000

# MySQL / MariaDB (XAMPP default: root, no password)
DATABASE_URL=mysql://root@127.0.0.1:3306/sofa_forge

# Session JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-locally

# App identity. Must match the appId baked into session tokens.
VITE_APP_ID=sofa-co
OWNER_OPEN_ID=admin-local

# Manus OAuth — not reachable from a local machine, so login uses the dev route.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Optional integrations — blank means the app uses its fallbacks.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# ---- Frontend (Next.js) public vars — exposed to the browser, never secrets --
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ID=sofa-co
NEXT_PUBLIC_OAUTH_PORTAL_URL=
# Leave empty so /api/* stays same-origin and Next rewrites it to the backend.
NEXT_PUBLIC_API_URL=
# Local review only: plays animations even when the OS has "reduce motion" on.
NEXT_PUBLIC_FORCE_MOTION=true

# ---- Local dev login (backend/src/modules/auth/devAuth.ts) ----
ALLOW_DEV_LOGIN=true
DEV_ADMIN_EMAIL=admin@sofaco.local
DEV_ADMIN_PASSWORD=sofa-admin
DEV_ADMIN_NAME=Sofa Co. Admin
