# ===========================================================================
# Backend — Render Web Service environment
#
# These are set in Render → your service → Environment, NOT committed as a
# file. This template exists so nothing is forgotten. Every variable the
# backend actually reads is listed; anything absent from this list is unused.
#
# Sources of truth:
#   backend/src/core/env.ts, app.ts, server.ts, core/media.ts,
#   modules/auth/devAuth.ts
# ===========================================================================

# --- Required ---------------------------------------------------------------

NODE_ENV=production

# Do NOT set PORT or API_PORT on Render — Render injects PORT itself and the
# server reads it (server.ts). Setting API_PORT would override it and the
# health check would never pass.

# MySQL connection string. Render has no managed MySQL, so this points at an
# external host (Aiven / PlanetScale / Railway / your Hostinger VPS).
# Most managed MySQL providers require TLS:
#   mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://user:password@host:3306/sofa_forge

# Session JWT signing secret. Generate a fresh one — never reuse the local value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# App identity. Must match NEXT_PUBLIC_APP_ID on the frontend, because the
# session token carries this appId and the API verifies it.
VITE_APP_ID=sofa-co

# The openId that is treated as the shop owner (gets the `admin` role).
OWNER_OPEN_ID=admin-local

# Comma-separated list of browser origins allowed to call the API with
# cookies. Put the real Netlify URL here once it exists — no trailing slash.
# Include the deploy-preview domain too if the client reviews previews.
CORS_ORIGIN=https://your-site.netlify.app

# Uploaded product photography is written to disk. Render's filesystem is
# ephemeral, so this MUST point at a mounted Render Disk or every image the
# client uploads disappears on the next deploy or restart.
UPLOAD_DIR=/var/data/uploads

# --- Admin login ------------------------------------------------------------
# Manus OAuth is not configured, so the email+password route is the only way
# into /admin. It is off by default in production, so it must be switched on
# explicitly — and given a real password, because this is now internet-facing.
ALLOW_DEV_LOGIN=true
DEV_ADMIN_EMAIL=admin@thesofaco.ca
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=Sofa Co. Admin

# --- Optional ---------------------------------------------------------------
# Leave blank unless the integration is actually being used; the code has
# fallbacks for each.

# Manus OAuth server. Blank = OAuth routes stay inert and dev login is used.
OAUTH_SERVER_URL=

# Manus Forge storage proxy (/manus-storage/*). Blank = proxy returns 500,
# which is fine while all images come from UPLOAD_DIR instead.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Shopify Storefront API (core/shopify.ts). Blank = Shopify features off.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# Catalogue import scripts only (src/db/seeders/importCatalog.ts). Not needed
# by the running server.
CATALOG_SOURCE_URL=
CATALOG_SAMPLE_SLUG=

# Single-container mode: serve a built frontend from this same process. Leave
# unset — the frontend is deployed separately on Netlify.
SERVE_STATIC=
STATIC_DIR=
